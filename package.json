{
  "name": "checkboxes",
  "version": "0.1.1",
  "private": true,
  "description": "Checklist items that task plugins ignore, for Obsidian.",
  "author": "Agata Dalach",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.1",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.15.3",
    "esbuild": "0.25.5",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "14.0.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.4"
  }
}
